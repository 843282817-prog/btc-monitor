import time
import requests

# ----------------- 1. 基础配置 -----------------
BARK_KEY = "4pbUuPZa73KPBtF6vYBp3B"  # 你的 Bark Key
INST_ID = "BTC-USDT-SWAP"            # OKX 永续合约代码
print("🚀 OKX BTC 监控脚本准备启动...")

# ----------------- 2. 工具函数：发送 Bark 推送 -----------------
def send_bark_alert(title, body):
    url = f"https://api.day.app/{BARK_KEY}/{title}/{body}?group=OKX_BTC_Alert&sound=alarm"
    try:
        response = requests.get(url, timeout=5)
        if response.status_code == 200:
            print("[推送成功] Bark 通知已发送至 iPhone")
        else:
            print(f"[推送失败] HTTP 状态码: {response.status_code}")
    except Exception as e:
        print(f"[推送异常] {e}")

# ----------------- 3. 获取 OKX 公开接口行情数据 -----------------
def get_okx_data():
    base_url = "https://www.okx.com"
    headers = {"User-Agent": "Mozilla/5.0"}

    # 1. 获取 OKX 永续合约资金费率
    funding_url = f"{base_url}/api/v5/public/funding-rate?instId={INST_ID}"
    funding_res = requests.get(funding_url, headers=headers, timeout=5).json()
    funding_rate = float(funding_res["data"][0]["fundingRate"]) * 100  # 转成百分比

    # 2. 获取 OKX 最新标记价格
    ticker_url = f"{base_url}/api/v5/market/ticker?instId={INST_ID}"
    ticker_res = requests.get(ticker_url, headers=headers, timeout=5).json()
    current_price = float(ticker_res["data"][0]["last"])

    # 3. 获取 OKX 15分钟 K 线数据 (计算 MA20 均线)
    candles_url = f"{base_url}/api/v5/market/candles?instId={INST_ID}&bar=15m&limit=20"
    candles_res = requests.get(candles_url, headers=headers, timeout=5).json()
    
    closes = [float(k[4]) for k in candles_res["data"]]
    ma20 = sum(closes) / len(closes) if len(closes) > 0 else current_price

    return current_price, funding_rate, ma20

# ----------------- 4. 核心监控逻辑 -----------------
def monitor_once():
    try:
        price, funding_rate, ma20 = get_okx_data()
        print(f"[OKX 盘面检查] BTC 价格: {price:.1f} USDT | 15m MA20: {ma20:.1f} | 资金费率: {funding_rate:.4f}%")

        conditions_met = []
        signal_type = None

        # 空单触发条件：费率偏高 + 15m K线跌破 MA20 均线
        if funding_rate >= 0.015:
            conditions_met.append(f"费率偏高 (+{funding_rate:.3f}%)")
        if price < ma20:
            conditions_met.append("15m跌破MA20均线")

        if len(conditions_met) >= 2:
            signal_type = "SHORT"
        # 多单触发条件：费率偏负 + 15m K线突破 MA20 均线
        elif funding_rate <= -0.010 and price > ma20:
            conditions_met.append(f"费率偏负 ({funding_rate:.3f}%)")
            conditions_met.append("15m突破MA20均线")
            signal_type = "LONG"

        # 如果触发信号，则发送 Bark 通知
        if signal_type == "SHORT":
            title = "🚨 OKX-BTC 逢高做空提醒"
            sl_price = price * 1.01
            tp1_price = price * 0.985
            body = f"满足条件:{' + '.join(conditions_met)}\n当前价:{price:.1f}\n参考止损:{sl_price:.1f}\n参考止盈:{tp1_price:.1f}"
            send_bark_alert(title, body)
        elif signal_type == "LONG":
            title = "🟢 OKX-BTC 逢低做多提醒"
            sl_price = price * 0.99
            tp1_price = price * 1.015
            body = f"满足条件:{' + '.join(conditions_met)}\n当前价:{price:.1f}\n参考止损:{sl_price:.1f}\n参考止盈:{tp1_price:.1f}"
            send_bark_alert(title, body)
        else:
            print("[状态] 暂未满足多条件共振信号，继续等待...")

    except Exception as e:
        print(f"[运行异常]: {e}")

if __name__ == "__main__":
    monitor_once()
